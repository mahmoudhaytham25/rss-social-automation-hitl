        "jsCode": "let outputs= [];\n\nfor (const item of $input.all()) {\n  let post = item.json.output.content\n  post = post.replace(/\\\\/g, \"\\\\\\\\\");\n  post = post.replace(/\"/g, '\\\\\"');\n\n  let title = item.json.title;\n  title = title.replace(/\\\\/g, \"\\\\\\\\\");\n  title = title.replace(/\"/g, '\\\\\"');\n  item.json.title = title;\n  \n  item.json.facebook = post;\n  \n  outputs.push(item);\n}\nreturn outputs;"
