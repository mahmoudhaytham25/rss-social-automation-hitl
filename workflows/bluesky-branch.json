        "jsonBody": "={\n  \"repo\": \"mhaytham.bsky.social\",\n  \"collection\": \"app.bsky.feed.post\",\n  \"record\": {\n    \"text\": \"{{ $json.post }}\",\n    \"createdAt\": \"{{ $now.toISO() }}\",\n    \"facets\": {{ JSON.stringify($json.facets) }}\n  }\n}\n",
