    {
      "parameters": {
        "jsCode": "for (const item of $input.all()) {    \n  item.json.output.content += \" \" + item.json.link+ \" #FirstAIMovers\"\n  \n  item.json.output.length = item.json.output.content.length;\n  \n  if (item.json.output?.content && item.json.output.length > item.json.limit) {\n    item.json.output.continue = false;\n    continue;\n  }\n\n  item.json.output.continue= true;\n}\n\nreturn $input.all();"
      },
