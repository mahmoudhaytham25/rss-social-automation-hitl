      "id": "07732177-a5a8-459e-aa9b-7173f47d48be",
      "name": "Post Creation w/ Clickable Link, Hashtag, Embedded Image1"
    },
    {
      "parameters": {
        "jsCode": "function utf8Length(str) {\n  let len = 0;\n  for (let i = 0; i < str.length; i++) {\n    const code = str.charCodeAt(i);\n    if (code < 0x80) {\n      len += 1;\n    } else if (code < 0x800) {\n      len += 2;\n    } else if (code >= 0xD800 && code <= 0xDBFF) {\n      // High surrogate - this is part of a 4-byte character\n      len += 4;\n      i++; // Skip the next low surrogate\n    } else if (code < 0x10000) {\n      len += 3;\n    } else {\n      len += 4;\n    }\n  }\n  return len;\n}\n\nfunction getUtf8ByteIndex(str, charIndex) {\n  return utf8Length(str.slice(0, charIndex));\n}\n\nconst results = [];\n\nfor (const item of $input.all()) {\n  let post = item.json.output.content;\n  const facets = [];\n  \n  // Hashtags\n  const hashtagRegex = /#\\w+/g;\n  let match;\n  while ((match = hashtagRegex.exec(post)) !== null) {\n    const tagText = match[0];\n    const start = match.index;\n    const end = start + tagText.length;\n  \n    const byteStart = getUtf8ByteIndex(post, start);\n    const byteEnd = getUtf8ByteIndex(post, end);\n  \n    facets.push({\n      index: { byteStart, byteEnd },\n      features: [\n        {\n          $type: \"app.bsky.richtext.facet#tag\",\n          tag: tagText.substring(1),\n        },\n      ],\n    });\n  }\n  \n  // Links\n  const linkRegex = /https?:\\/\\/\\S+/g;\n  while ((match = linkRegex.exec(post)) !== null) {\n    const url = match[0];\n    const start = match.index;\n    const end = start + url.length;\n  \n    const byteStart = getUtf8ByteIndex(post, start);\n    const byteEnd = getUtf8ByteIndex(post, end);\n  \n    facets.push({\n      index: { byteStart, byteEnd },\n      features: [\n        {\n          $type: \"app.bsky.richtext.facet#link\",\n          uri: url,\n        },\n      ],\n    });\n  }\n  post = JSON.stringify(post).slice(1, -1);\n\n  let title = item.json.title;\n  title = JSON.stringify(title).slice(1, -1);\n  \n  results.push({\n    json: {\n      token: item.json.token,\n      post: post,\n      facets: facets,\n      blob: item.json.blob,\n      link: item.json.link,\n      title: title\n    }\n  });\n}\n\nreturn results;"
      },
