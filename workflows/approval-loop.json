        "jsCode": "// Classifies the Discord approval outcome for this platform.\n// A clicked button sets data.approved; a missing value means the wait\n// timed out, so we re-ask up to MAX_REASKS times then skip the platform.\nconst MAX_REASKS = 3;\nconst item = $json;\nconst approved = item.data ? item.data.approved : undefined;\nlet reasks = item.reasks ?? 0;\nlet decision;\nif (approved === true) decision = 'approved';\nelse if (approved === false) decision = 'declined';\nelse {\n  reasks += 1;\n  decision = reasks >= MAX_REASKS ? 'skip' : 'reask';\n}\nreturn { json: { ...item, decision, reasks } };",
