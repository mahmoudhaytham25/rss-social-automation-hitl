# Copy to .env and fill in the values:
#   cp .env.example .env
# .env is gitignored — never commit it.

# ---------------------------------------------------------------------------
# N8N_ENCRYPTION_KEY (REQUIRED)
# Secret used to encrypt saved credentials in the n8n database.
# Generate once and never change it — changing it afterwards makes every
# stored credential unreadable and you will have to recreate them all.
#
#   openssl rand -hex 32
# ---------------------------------------------------------------------------
N8N_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# WEBHOOK_URL (REQUIRED for Discord approvals)
# Public base URL of this n8n instance. The Discord `sendAndWait` approval
# links (and the OAuth2 callback shown in the Discord credential) are built
# from this URL. With the default localhost value, Approve/Decline buttons
# only work on this machine.
#
# To approve posts from your phone or another device, expose n8n publicly and
# set this to that URL — see docs/ngrok-approval-setup.md, e.g.
#   WEBHOOK_URL=https://<your-subdomain>.ngrok-free.app/
# ---------------------------------------------------------------------------
WEBHOOK_URL=http://localhost:5678/

# ---------------------------------------------------------------------------
# GENERIC_TIMEZONE
# Timezone used for schedule triggers and date helpers ($today, $now).
# TZ database names: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
# ---------------------------------------------------------------------------
GENERIC_TIMEZONE=America/New_York

# ---------------------------------------------------------------------------
# N8N_SECURE_COOKIE
# Required for local development over plain http://localhost:5678. n8n's
# session cookie is Secure by default, which browsers will not send over HTTP,
# leaving you stuck at the login screen. Remove this (or set it to true) once
# you serve n8n over HTTPS.
# ---------------------------------------------------------------------------
N8N_SECURE_COOKIE=false

# ---------------------------------------------------------------------------
# N8N_RUNNERS_ENABLED / DB_SQLITE_POOL_SIZE
# Both are recommended by n8n itself (it logs deprecation warnings without
# them): task runners isolate Code-node execution and will be mandatory in
# n8n 2.x; a SQLite read pool avoids deprecation warnings and helps under
# concurrent load. Defaults here keep the compose logs warning-free.
# ---------------------------------------------------------------------------
N8N_RUNNERS_ENABLED=true
DB_SQLITE_POOL_SIZE=2
